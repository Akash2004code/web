<html>
<frameset rows="30%,70%">
    <!-- Top frame -->
    <frame src="new.html" name="topFrame" noresize>

    <!-- Nested frameset for columns -->
    <frameset cols="25%,*">
        <!-- Left vertical frame -->
        <frame src="left.html" name="leftFrame">
        <!-- Right vertical frame -->
        <frame src="right.html" name="rightFrame">
		<frame src="dis.html" name="rightFrame">
    </frameset>

    <noframes>
        <body>
            Your browser does not support frames.
        </body>
    </noframes>
</frameset>
</html>
